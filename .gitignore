# ESP-IDF
build/
build_*/
build_*.log
sdkconfig
sdkconfig.old

# Local, uncommitted build settings -- and the place for secrets like broker
# credentials. See the note in the top-level CMakeLists.txt.
sdkconfig.local
sdkconfig.local.*
!sdkconfig.local.example
managed_components/
dependencies.lock

# Host tests. .cache holds the pinned cJSON that run_tests.sh fetches when this tree has
# no managed_components/ -- a build artefact, not a dependency to commit.
.cache/
test/host/run_tests
test/host/*.dSYM

# Bench OTA rig: generated certificate and whatever was published into it
test/rig/certs/
test/rig/firmware/
test/rig/mqtt-cmd*

# Certificates: generated per-developer, never committed.
nas/certs/
server_certs/ca_cert.pem
*.key
*.srl

# Mosquitto credentials and broker state.
nas/mosquitto/

# App signing keys. Losing one means no device signed with it can be updated again, and
# committing one means anyone can sign an image your devices will accept.
keys/*
!keys/README.md

# Editor / OS
.vscode/
.DS_Store
build.log

# Local Wi-Fi credentials for the bench board. Never commit; wifi.json.example is the
# shape, without the values.
wifi.json

# The ESP-IDF Installation Manager's own config: absolute paths on one machine, & the
# username in them. Regenerated by the installer, useful to nobody else.
eim_config.toml
